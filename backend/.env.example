# ==============================================================================
# AgriDrone AI — Environment Configuration Template
# Placeholders only. Copy to .env and configure for your environment.
# ==============================================================================

# Application Mode: LIVE (real sensors/drone/DB) or DEMO (deterministic demonstration)
APP_MODE=DEMO

# Environment: development, production, test
NODE_ENV=development

# Server Port
PORT=5000

# Canonical MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/agri_drone_ai

# Mandatory JWT Secret (minimum 16 chars, strong entropy in LIVE mode)
JWT_SECRET=replace_with_a_strong_secret_at_least_16_chars

# Ollama Vision-Language Model API
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:8b

# Directory for file uploads
UPLOAD_DIR=./uploads

# Frontend URL (Used for CORS authorization)
FRONTEND_URL=http://localhost:5173

# Comma-separated list of additional allowed CORS origins (Wildcard * forbidden)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Limits and Performance
MAX_UPLOAD_SIZE_MB=50
OLLAMA_TIMEOUT_MS=60000
OLLAMA_MAX_RETRIES=3
OLLAMA_MAX_CONCURRENCY=2
LOG_LEVEL=info

# Set to true only in DEMO mode to explicitly use in-memory database
USE_MEMORY_DB=false
